# rv-tests: track scripts/docs/src only. Everything below is rebuilt per machine
# or is run output — never sync it via git.

# Built agents (regenerate on each box with build-agents.sh) — but keep the doc.
agents/*.jar
agents.bak-*/
!agents/NOTE.md

# Run outputs
results/
dacapo-results/
*-results/
*-results-*/
classes/

# Exploratory / third-party fixtures
scratch/

# Logs, crash dumps, profiler artifacts
*.log
*.jfr
*.collapsed.txt
ajcore.*
